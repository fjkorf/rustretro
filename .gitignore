/target

# Editor / backup files
*.bak
*~

# Emulator content & cores (don't commit ROMs, BIOS, or core libraries)
*.dylib
*.so
*.dll
*.nes
*.zip
*.bin
*.md5

# Per-run sidecars and machine-local state
*.regions.json
rustretro_layout*.json
rustretro_training*.json
*.srm
*.nv
nvram/
cfg/

# Machine-local Cargo config (external target-dir)
.cargo/config.toml

# Local secrets / migration credentials — never commit
.env
.env.*
shadow/train/.venv/
*.state[1-9]

# Machine/user-local artifacts
keymap.json
*.keymap.json
__pycache__/
scripts/re/revenv/
# Training data & derived models (goat-v2 stays tracked for the runner tests)
shadow/recordings/
shadow/models/
shadow/arenas/*/current.state
shadow/arenas/*/current.meta.json
shadow/inputs/
scratchpad/
.DS_Store
.claude/settings.local.json
.claude/worktrees/
